{
  "name": "cobblemon-smartphone-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "Web creator hub for Cobblemon Smartphone (Themes, UI Screens, Actions & 3D Skins)",
  "scripts": {
    "sync:assets": "node scripts/sync-mod-assets.mjs",
    "dev": "pnpm run sync:assets && vite",
    "build": "pnpm run sync:assets && tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "jszip": "^3.10.1",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0",
    "three": "^0.187.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^26.6.11",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.4",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.5.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
